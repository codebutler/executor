index 9327bca..3cf035a 100644
--- a/include/syn68k_public.h
+++ b/include/syn68k_public.h
@@ -19,7 +19,7 @@ extern "C"
 # elif defined(__alpha) || defined(i860) || defined(vax) || defined(i386) \
      || defined(__x86_64) || defined(__x86_64__) \
      || defined (_M_X64) || defined(_M_IX86) \
-     || defined(__arm__) || defined(__aarch64__)
+     || defined(__arm__) || defined(__aarch64__) || defined(__wasm__)
 #  define LITTLEENDIAN
 # else
 #  error "Unknown CPU type"
@@ -45,7 +45,7 @@ extern "C"
        && !defined (__ppc__) && !defined(__x86_64) \
        && !defined(__x86_64) && !defined(__x86_64__) \
        && !defined (_M_X64) && !defined(_M_IX86) \
-       && !defined(__arm__) && !defined(__aarch64__)
+       && !defined(__arm__) && !defined(__aarch64__) && !defined(__wasm__)
 
 #  error Unknown CPU type
 # endif
@@ -234,7 +234,38 @@ extern DebuggerCallbacks syn68k_debugger_callbacks;
 #if SIZEOF_CHAR_P == 4 && !defined(TWENTYFOUR_BIT_ADDRESSING)
 
 extern uint32 ROMlib_offset;
+#if defined(__wasm__)
+/* Non-32-bit-clean (24-bit era) apps store the classic Memory Manager tag
+ * bits in the high byte of master pointers themselves (lock 0x80, purgeable
+ * 0x40, resource 0x20 — e.g. MacPaint implements HLock as BSET #7 on the
+ * master pointer) and then dereference those tagged values directly. On a
+ * real 24-bit Mac the hardware ignores the high byte; under 32-bit syn68k
+ * the tagged address maps outside the wasm heap and traps. Make the mapping
+ * tag-transparent, keyed on the real invariant: only when the direct
+ * mapping would land beyond the wasm linear memory AND clearing the three
+ * classic tag bits yields an in-heap mapping do we use the cleared address.
+ * Every working access (including host-object addresses that wrap around
+ * 2^32) maps in-heap directly and is untouched; only accesses that would
+ * otherwise be fatal are remapped, mirroring the 24-bit hardware masking. */
+static inline uint16 *SYN68K_TO_US_TAGSAFE(uint32 addr)
+{
+    unsigned long res = (unsigned long)addr + ROMlib_offset;
+    if((addr & 0xE0000000) != 0)
+    {
+        unsigned long heap = (unsigned long)__builtin_wasm_memory_size(0) << 16;
+        if(res >= heap)
+        {
+            unsigned long cleared = (unsigned long)(addr & 0x1FFFFFFF) + ROMlib_offset;
+            if(cleared < heap)
+                res = cleared;
+        }
+    }
+    return (uint16 *)res;
+}
+#define SYN68K_TO_US(addr) SYN68K_TO_US_TAGSAFE((uint32)(unsigned long)(addr)) /* uint16 * only the default. */
+#else
 #define SYN68K_TO_US(addr) ((uint16 *) ((unsigned long)addr + ROMlib_offset)) /* uint16 * only the default. */
+#endif
 #define US_TO_SYN68K(addr) (/*(syn68k_addr_t)*/(int32) (addr) - ROMlib_offset)
 
 #else
